{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "TodoWrite|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/autocondense/hooks/ac_hook.py\" PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/autocondense/hooks/ac_hook.py\" PostToolUseFailure",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/autocondense/hooks/ac_hook.py\" Stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|clear|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/autocondense/hooks/ac_hook.py\" SessionStart",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
